+// The camera change that carries the arrow animation runs as a user event in
+// a later frame. Another camera change, for example an app rotation, can
+// interrupt it or hold it back, so the arrow animation never starts. The
+// arrow then stays pending: GetDrawableAzimut keeps returning the old angle,
+// which equals m_direction, so OnCompassUpdate never turns the map again.
+void MyPositionController::DropPendingAnimationWithoutArrow()
+{
+  // A later handover, for example after a GPS fix, keeps the first time, so
+  // repeated lost animations cannot postpone the drop.
+  if (m_isAnimCreatorHandedOver)
+  {
+    m_isAnimCreatorHandedOver = false;
+    if (!m_isPendingAnimationTimed)
+    {
+      m_isPendingAnimationTimed = true;
+      m_pendingAnimationStart = std::chrono::steady_clock::now();
+    }
+  }
+  if (!m_isPendingAnimation || m_animCreator != nullptr || !m_isPendingAnimationTimed)
+    return;
+  if (std::chrono::steady_clock::now() - m_pendingAnimationStart < kMaxPendingArrowAnimation)
+    return;
+
+  m_isPendingAnimation = false;
+  m_isPendingAnimationTimed = false;
+  if (m_mode == location::FollowAndRotate && !m_isInRouting)
+  {
+    m_direction = m_arrowDirection;
+    m_isDirtyViewport = true;
+  }
+}
