+void Navigator::SetPerspectiveAngle(double angle, std::optional<m2::PointD> const & anchor)
+{
+  std::optional<m2::PointD> anchorPixel;
+  if (anchor)
+    anchorPixel = m_Screen.PtoP3d(m_Screen.GtoP(*anchor));
+  // The same view as the auto tilt at this angle: the largest angle is the
+  // angle itself.
+  if (angle <= 0.0)
+  {
+    Disable3dMode();
+    m_Screen.SetAutoPerspective(false);
+  }
+  else
+  {
+    angle = std::min(angle, ScreenBase::CalculateAutoPerspectiveAngle(0.0 /* scale */));
+    m_Screen.ApplyPerspective(angle, angle, m_Screen.GetAngleFOV());
+  }
+  if (anchorPixel)
+    m_Screen.MatchGandP3d(*anchor, *anchorPixel);
+}
