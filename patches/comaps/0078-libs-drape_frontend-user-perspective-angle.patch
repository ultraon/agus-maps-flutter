+void Navigator::SetPerspectiveAngle(double angle)
+{
+  double const maxAngle = ScreenBase::CalculateAutoPerspectiveAngle(0.0 /* scale */);
+  if (angle <= 0.0)
+  {
+    Disable3dMode();
+    m_Screen.SetAutoPerspective(false);
+    return;
+  }
+  angle = std::min(angle, maxAngle);
+  if (m_Screen.isPerspective() && !m_Screen.isAutoPerspective() && m_Screen.GetMaxRotationAngle() == maxAngle)
+    m_Screen.SetRotationAngle(angle);
+  else
+    m_Screen.ApplyPerspective(angle, maxAngle, m_Screen.GetAngleFOV());
+}
